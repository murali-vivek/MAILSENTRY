{
  "name": "mailsentry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Explainable vendor-email investigation tool for accounts-payable teams.",
  "scripts": {
    "dev": "concurrently -k -n worker,client -c blue,green \"npm run dev:worker\" \"npm run dev:client\"",
    "dev:client": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:worker": "node scripts/ensure-dist.mjs && wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.worker.config.ts",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:client": "vitest run --config vitest.config.ts --project client",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mailsentry-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mailsentry-db --remote",
    "cf:whoami": "wrangler whoami",
    "smoke": "node scripts/smoke-test.mjs",
    "check:cf": "node scripts/check-cloudflare-config.mjs"
  },
  "dependencies": {
    "postal-mime": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
