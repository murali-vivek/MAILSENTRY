{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailsentry",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": false
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailsentry-db",
      "database_id": "93efaccb-1b19-4adb-b87b-c539ae6acfb5",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "MAILSENTRY_ENABLE_DEMO_RESET": "false"
  }
}
